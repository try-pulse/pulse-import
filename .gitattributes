# Normalize text; keep vendor as vendored for GitHub Linguist.
* text=auto eol=lf

*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary

vendor/** linguist-vendored
